    "%@ didn’t return its model list. The built-in models still work." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有返回模型列表，内置模型仍可使用。"
          }
        }
      }
    },
    "%@ in %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在“%2$@”中%1$@"
          }
        }
      }
    },
    "%@ in %@. Open Poki to allow or deny." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“%2$@”中%1$@。打开 Poki 允许或拒绝。"
          }
        }
      }
    },
    "%@ in %@. Touch and hold to allow or deny." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@。按住可允许或拒绝。"
          }
        }
      }
    },
    "%@ is chosen, but nothing answers at 10.7.0.1 right now. Open %@, make sure it is connected with the loopback on, then come back; this page updates by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择 %1$@，但 10.7.0.1 目前没有响应。请打开 %2$@，确认已连接并开启回环后再回来，此页面会自动更新。"
          }
        }
      }
    },
    "%@ is signing in through %@ and returns to %@, which isn’t on Poki’s list of known agents. Allow it only if you are connecting it yourself right now. It could then see your screen and act on this iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在通过 %2$@ 登录，登录后会返回 %3$@，它不在 Poki 已知的智能体列表中。只有当你正在亲自连接它时才允许。允许后它可以看到你的屏幕，并在此 iPhone 上操作。"
          }
        }
      }
    },
    "%@ key" : {
      "localizations" : {
        "zh-Hans" : {
