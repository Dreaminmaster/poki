      }
    },
    "Open %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 %@"
          }
        }
      }
    },
    "Open **Poki Setup** on your Mac or PC, connect this iPhone by cable, and tap **Pair**. Tap **Trust** on the iPhone when asked." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Mac 或 PC 上打开“**Poki Setup**”，用数据线连接此 iPhone，然后轻点“**配对**”。iPhone 询问时轻点“**信任**”。"
          }
        }
      }
    },
    "Open **Settings › Developer**. It appears once Developer Mode is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“**设置 › 开发者**”。开启开发者模式后会显示此选项。"
          }
        }
      }
    },
    "Open **Settings › General › Keyboard › Keyboards › Add New Keyboard** and choose **Poki**." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开**设置 › 通用 › 键盘 › 键盘 › 添加新键盘**，选择 **Poki**。"
          }
        }
      }
    },
    "Open **Settings › General › VPN & Device Management**, tap your Apple ID, then tap **Trust**." : {
