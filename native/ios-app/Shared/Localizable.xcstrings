    },
    "The answer was cut off." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复已截断。"
          }
        }
      }
    },
    "The approval ran out, so Poki skipped that step" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准超时，已跳过此步骤"
          }
        }
      }
    },
    "The built-in connection runs on a physical iPhone. External connection options are shown below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置连接只能在真机上运行。下方列出外部连接方式。"
          }
        }
      }
    },
    "The built-in connection runs on a physical iPhone. Use your proxy app above." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置连接只能在真机上运行。请使用上方的代理 App。"
          }
        }
      }
    },
    "The developer disk image did not install. Poki downloads it again by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者磁盘映像未能安装，Poki 会自动重新下载。"
          }
        }
      }
    },
    "The developer disk image is not downloaded yet (Setup > Pair). It is needed once." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者磁盘映像尚未下载（设置引导 › 配对），只需下载一次。"
          }
        }
      }
    },
    "The first time Poki Runner starts after a restart, iOS asks for your passcode to allow automation. Enter it once; Poki never sees it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 重新启动后首次启动 Poki Runner 时，iOS 会要求输入锁屏密码以允许自动化操作。只需输入一次，Poki 无法读取该密码。"
          }
        }
      }
    },
    "The first time Poki turns on after a restart, iOS asks for your passcode to allow automation. Enter it once; Poki never sees it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重启后 Poki 第一次开启时，iOS 会要求输入锁屏密码以允许自动化。输入一次即可，Poki 看不到它。"
          }
        }
      }
    },
    "The helper app that taps and types for your agent. Poki starts it; you never open it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替智能体执行轻点和输入的辅助 App。由 Poki 自动启动，无需手动打开。"
          }
        }
      }
    },
    "The keychain did not take the key. Try again." : {
