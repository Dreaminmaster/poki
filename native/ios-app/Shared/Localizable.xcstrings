    "Poki is turning on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 正在开启。"
          }
        }
      }
    },
    "Poki is typing" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 正在输入"
          }
        }
      }
    },
    "Poki is working on a task for %@. Try again when it’s done." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 正在为 %@ 执行任务，完成后再试。"
          }
        }
      }
    },
    "Poki keeps itself running with silent audio. Always Allow makes that sturdier, and iOS shows no location indicator for it. Poki never records your location." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会用静音音频保持运行。设为“始终允许”会更稳定，iOS 也不会为此显示定位标志。Poki 从不记录你的位置。"
          }
        }
      }
    },
    "Poki keeps the key now; chatting with %@ comes in an update. Until then, choose Anthropic or OpenAI." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥已保存。%@ 对话功能将在后续更新中推出，目前请选择 Anthropic 或 OpenAI。"
          }
        }
      }
    },
    "Poki keeps the password in this iPhone’s Keychain to sign itself again every week." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 把密码保存在此 iPhone 的钥匙串中，用于每周重新签名。"
          }
        }
      }
    },
    "Poki keeps this key; chatting with %@ comes in an update." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poki 会保留这个密钥，与 %@ 对话将在后续更新中支持。"
